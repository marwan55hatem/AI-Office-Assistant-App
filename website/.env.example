# Copy to .env.local for local development. Never commit .env files.
# The Office Assistant API (server side only; the browser never calls it directly).
API_URL=http://127.0.0.1:8766
# The public address of this website (canonical links, sitemap).
SITE_URL=http://localhost:3100
# Shared with the API (WEB_PROXY_SECRET there too): lets the API rate-limit each visitor, not this server.
WEB_PROXY_SECRET=
# Optional: the API's WebSocket address as browsers reach it, if it differs from API_URL (e.g. wss://api.example.com).
PUBLIC_API_WS_URL=
# Optional: a GitHub token raises the release-list rate limit (60 calls/hour without).
GITHUB_TOKEN=
# Local testing over plain http only: allow the session cookies without the Secure flag.
# ALLOW_INSECURE_COOKIES=1
