# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
# The app connects as a role WITHOUT superuser/BYPASSRLS (see scripts/create_app_role.sql).
DATABASE_URL=postgresql+psycopg://office_app:CHANGE_ME@localhost:55432/office
# Migrations run as the owner.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://office_owner:CHANGE_ME@localhost:55432/office
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ORIGINS=["http://localhost:3000"]

# The online chat model (Groq). Get a key at https://console.groq.com/keys - never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tokens (prompt + answer) one company may use per UTC day.
AI_DAILY_TOKEN_BUDGET=100000

# E-mail notifications. EMAIL_PROVIDER: off | console (development: logs only) | smtp | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM=Office Assistant <no-reply@example.com>
# Resend: https://resend.com/api-keys  (sandbox sender: onboarding@resend.dev, only to your own address)
RESEND_API_KEY=
# SendGrid: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# SMTP (e.g. Gmail with an app password: smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The "Open" link in e-mails (the website)
APP_LINK_URL=http://localhost:3000

# Shared with the website (WEB_PROXY_SECRET there too): the website may then pass on each visitor's IP
# for the sign-in rate limits. At least 32 random characters.
WEB_PROXY_SECRET=
